# GroqCloud API Keys (6-key convention: each key is shared by a sector pair)
AGR_REAL_KEY=
FIN_FIS_KEY=
CAP_MON_KEY=
ORCH_KEY=
PRIC_LAB_KEY=
SERV_EXT_KEY=

# Models
FAST_MODEL=openai/gpt-oss-20b
REASONING_MODEL=openai/gpt-oss-120b

# Web Search API Keys
TVLY_KEY_1=
TVLY_KEY_2=
TVLY_KEY_3=

# Agriculture ready-made MCP sources (no sample data fallback)
DATA_GOV_IN_API_KEY=
CEDA_API_KEY=
AGRICULTURE_USE_READYMADE_SOURCES=true
AGRICULTURE_MOSPI_URL=https://mcp.mospi.gov.in/
AGRICULTURE_WEATHER_COMMAND=node
AGRICULTURE_WEATHER_SCRIPT=.mcp-sources/Indian-Weather-MCP-Server/build/index.js
AGRICULTURE_MCP_TIMEOUT=90
# Optional per-category MCP overrides and verified OGD resource/field mappings.
AGRICULTURE_MCP_SOURCES={}
AGRICULTURE_OGD_RESOURCES={}

# A2A protocol guards (defaults shown)
A2A_MAX_DEPTH=5
A2A_MAX_HOPS=25
A2A_REQUEST_TIMEOUT=90
A2A_PEER_TIMEOUT=25
A2A_MAX_RETRIES=1
A2A_LLM_ROUTING=true
A2A_API_KEY=
# POST /a2a/v1/requests is refused when no key is set; enable for local development only.
A2A_ALLOW_ANONYMOUS_REQUESTS=false

# Browser origins allowed to call the API (JSON list). The Vite dev proxy is same-origin and needs none.
# CORS_ORIGINS=["http://localhost:5173"]

# Optional Neo4j mirror of the knowledge graph ontology (NetworkX stays the runtime engine).
# Leave NEO4J_URI empty to disable. Install with: uv pip install -e ".[neo4j]"
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
